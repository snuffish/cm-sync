#!/usr/bin/env bash
# Entry point: symlink this file onto PATH. Resolves symlinks to find cm_sync.py next to it.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
# Git Bash on Windows usually has python, not python3
python=python3
command -v python3 >/dev/null 2>&1 || python=python
exec "$python" -I "$(cd -P "$(dirname "$src")" && pwd)/cm_sync.py" "$@"
